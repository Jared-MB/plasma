{
	"name": "@crm/plasma",
	"version": "1.0.0",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"test": "vitest run",
		"check-types": "tsc --noEmit",
		"lint": "biome lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"tsdown": "0.21.9",
		"typescript": "5.9.3",
		"vitest": "4.0.18",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@kristall/try-catch": "2.0.0",
		"object-to-formdata": "4.5.1"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"keywords": [],
	"author": "Cruz Roja Mexicana, Delegación Puebla",
	"contributors": [
		{
			"name": "Jared Muñoz",
